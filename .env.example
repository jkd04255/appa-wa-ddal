# Public, project-specific key only. Never a service_role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after Google OAuth client + Supabase provider + callback are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GitHub Pages builds already set this to /appa-wa-ddal.
# NEXT_PUBLIC_BASE_PATH=/appa-wa-ddal
